    "robotsText": "User-agent: *\nDisallow: /cgi-bin\n",
    "global_header_custom": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\", \n  \"@type\": \"BreadcrumbList\", \n  \"itemListElement\": [{\n    \"@type\": \"ListItem\", \n    \"position\": 1, \n    \"name\": \"Skyview Watersports Aruba\",\n    \"item\": \"https://skyviewwatersports.pages.dev/\"  \n  },{\n    \"@type\": \"ListItem\", \n    \"position\": 2, \n    \"name\": \"Aruba's Leading Parasailing Tour Operator\",\n    \"item\": \"https://skyviewwatersports.pages.dev/About-Skyview-Watersports-Aruba\"  \n  },{\n    \"@type\": \"ListItem\", \n    \"position\": 3, \n    \"name\": \"Skyview Watersports Tours and Activities\",\n    \"item\": \"https://skyviewwatersports.pages.dev/Tours-Activities-Skyview-Watersports-Aruba\"  \n  }]\n}\n</script>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"WebSite\",\n  \"name\": \"Skyview Aruba's Leading Parasailing Tour Operator\",\n  \"url\": \"https://skyviewwatersports.pages.dev/\",\n  \"potentialAction\": {\n    \"@type\": \"SearchAction\",\n    \"target\": \"{search_term_string}\",\n    \"query-input\": \"required name=search_term_string\"\n  }\n}\n</script>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"VideoObject\",\n  \"name\": \"Parasailing in Aruba with Skyview Watersports | Are You Ready to Fly!\",\n  \"description\": \"Get ready for an unforgettable parasailing adventure with Skyview Watersports. Adventure seekers looking for an unforgettable adrenaline boost can take to the skies and parasail through the warm Caribbean air. Experience the once in a lifetime view of Aruba above water. \n\nBook all of your watersports in Aruba today at: skyviewwatersports.com\",\n  \"thumbnailUrl\": \"https://i.ytimg.com/an_webp/_lZvO2CxrJY/mqdefault_6s.webp?du=3000&sqp=CPqek9MG&rs=AOn4CLDdPZYrNc-r_vlGggFtVzGHkNTBYw\",\n  \"uploadDate\": \"2022-06-17\",\n  \"duration\": \"PT0M54S\",\n  \"embedUrl\": \"https://youtu.be/_lZvO2CxrJY?si=J3qjg8iWf8QMwtOY\"\n}\n</script>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"LocalBusiness\",\n  \"name\": \"Parasailing by Skyview Watersports Aruba\",\n  \"image\": \"https://static.wixstatic.com/media/d75ca9_87a1871eb0da433c96dcbbe223eb4e42~mv2.png/v1/fill/w_147,h_146,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/no%20background_edited_edited_edited.png\",\n  \"@id\": \"\",\n  \"url\": \"https://share.google/SgMTUb22EuZv1F6YP\",\n  \"telephone\": \"+297 5696985\",\n  \"priceRange\": \"$70\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"\",\n    \"addressLocality\": \"Noord, Aruba\",\n    \"postalCode\": \"0000\",\n    \"addressCountry\": \"AW\"\n  },\n  \"openingHoursSpecification\": {\n    \"@type\": \"OpeningHoursSpecification\",\n    \"dayOfWeek\": [\n      \"Monday\",\n      \"Tuesday\",\n      \"Wednesday\",\n      \"Thursday\",\n      \"Friday\",\n      \"Saturday\",\n      \"Sunday\"\n    ],\n    \"opens\": \"10:00\",\n    \"closes\": \"14:00\"\n  },\n  \"sameAs\": [\n    \"https://www.facebook.com/skyviewwatersportsaruba\",\n    \"https://www.youtube.com/@skyviewwatersportsaruba\",\n    \"https://www.skyviewwatersports.com/\"\n  ] \n}\n</script>\n\n\n",
